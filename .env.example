# Topclues Solutions – Payroll & Salary Slip Management System
# Production Environment Variables Template

# Supabase Client Configuration (publishable/anon key is safe to expose with RLS enabled)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your-key"

# Server-side only (used by Supabase CLI for migrations). Never commit this.
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres"

# Application URL
APP_URL="https://your-payroll-app.run.app"

# Banking Security & Envelope Encryption
# Google Cloud KMS Key Resource Name or AES-256 secret key for server-side encryption
KMS_KEY_RING=""
KMS_CRYPTO_KEY=""
BANKING_ENCRYPTION_SECRET="replace-with-secure-32-byte-hex-secret"

# Email Delivery Configuration (Choose either SMTP or Gmail API)
# Option 1: SMTP Transactional Mailer
SMTP_HOST="smtp.provider.com"
SMTP_PORT="587"
SMTP_USER="payroll-noreply@topclues.in"
SMTP_PASSWORD="replace-with-secret-smtp-password"

# Option 2: Gmail API OAuth Client
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
